{
  "manifest_version": 3,
  "name": "Erm... Actually!",
  "description": "The coolest fact-checker ever \u2014 highlights claims on a page that fact-checkers have reviewed.",
  "version": "0.0.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://factchecktools.googleapis.com/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Erm... Actually!",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
